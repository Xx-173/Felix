# Copy to deploy/web.env. Do not commit real credentials.
FELIX_DOMAIN=felix.example.com
FELIX_DEMO_DATA=1
FELIX_CONCURRENCY=2
FELIX_ACTIVE_VISITORS=32
FELIX_DAILY_RUN_LIMIT=1000
FELIX_VISITOR_DAILY_RUN_LIMIT=20
# Visitors enter their OWN model and market keys inside Settings.
# Additional custom model HTTPS domains approved by the deployment operator.
# Comma-separated hostnames only; leave empty for built-in providers.
FELIX_MODEL_ALLOWED_HOSTS=
# Optional >=32 characters. Otherwise generated and saved in the data volume.
# Keep this stable: it signs visitor cookies AND encrypts visitor credentials.
FELIX_COOKIE_SECRET=

# Optional registration invitation; empty = open registration.
FELIX_INVITE_CODE=
# Required behind Caddy; generate with: bun -e "console.log(crypto.randomUUID())"
FELIX_PROXY_SECRET=replace-with-random-proxy-secret
# Daily schedules use this server timezone.
TZ=Asia/Shanghai
